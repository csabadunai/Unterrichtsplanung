<p style="color: green"><%= notice %></p>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 style="font-family: 'Questrial';">My Subjects</h1>
  <%= link_to new_subject_path, class: "btn btn-primary shadow-sm" do %>
    <i class="bi bi-plus-lg"></i> New Subject
  <% end %>
</div>

<div class="row g-4" id="subjects">
  <% @subjects.each do |subject| %>
    <div id="<%= dom_id subject %>" class="card h-100 shadow-sm border-0 bg-white shadow-hover col-sm-6 col-md-4 col-lg-3">
      <%= link_to subject.name, subject, class: "text-decoration-none stretched-link", style: "color: inherit;" %>
      <div class="">
        <%= render subject %>
      </div>
    </div>
  <% end %>
</div>
