<p style="color: green"><%= notice %></p>

<%# 1. THE TOGGLE BUTTON %>
<div class="mb-3 text-end">
  <button class="btn btn-sm btn-outline-secondary shadow-sm" type="button" 
          data-bs-toggle="collapse" data-bs-target="#subjectAdminPanel" 
          aria-expanded="false" aria-controls="subjectAdminPanel">
    <i class="bi bi-sliders2-vertical me-1"></i> Toggle Admin Panel
  </button>
</div>

<%# 2. THE COLLAPSIBLE WRAPPER %>
<div class="collapse mb-4" id="subjectAdminPanel">
  <div class="row">
    <%# --- SUBJECT CARD --- %>
    <div class="col-md-4">
      <div class="card rounded-0 border-primary shadow-sm h-100">
        <div class="card-header rounded-0 bg-dark text-primary">
          <h5 class="mb-0" style="font-family: 'Questrial';"><%= @subject.name %></h5>
        </div>
        <div class="card-body d-flex flex-column">
          <div class="mb-4">
            <%= render @subject %>
          </div>
          <div class="mt-auto pt-3 border-top">
            <div class="d-flex flex-wrap gap-2">
              <%= link_to edit_subject_path(@subject), class: "btn btn-sm btn-outline-dark" do %>
                <i class="bi bi-pencil me-1"></i> Edit
              <% end %>
              <%= link_to subjects_path, class: "btn btn-sm btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-1"></i> Back
              <% end %>
              <div class="ms-auto"> 
                <%= button_to @subject, method: :delete, class: "btn btn-sm btn-outline-danger", 
                    data: { turbo_confirm: "Are you sure? This will delete all associated lessons." } do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card rounded-0 border-primary shadow-sm h-100">
        <div class="card-header rounded-0 bg-dark text-primary">
          <h6>Share this Subject</h6>
        </div>
        <div class="card-body">
          <%= form_with url: subject_collaborations_path(@subject), method: :post, class: "row g-2" do |f| %>
            <div class="col-md-6">
              <%= f.email_field :email, placeholder: "colleague@school.com", class: "form-control form-control-sm" %>
            </div>
            <div class="col-md-4">
              <%= f.select :role, [["Read Only", "viewer"], ["Can Edit", "editor"]], {}, class: "form-select form-select-sm" %>
            </div>
            <div class="col-md-2">
              <%= f.submit "Share", class: "btn btn-sm btn-primary w-100" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# --- GENERATOR CARD --- %>
    <div class="col-md-4">
      <div class="card border-primary rounded-0 shadow-sm h-100">
        <div class="card-header rounded-0 bg-dark text-primary">
          <h5 class="mb-0" style="font-family: 'Questrial';">Lesson Generator</h5>
        </div>
        <div class="card-body">
          <p class="text-muted small">Select a date range to automatically create lessons based on the schedule.</p>
          <%= form_with url: generate_lessons_subject_path(@subject), method: :post, class: "row g-3 align-items-end" do |f| %>
            <div class="col-md-6">
              <%= f.label :start_date, "Start Date", class: "form-label uppercase-label" %>
              <%= f.date_field :start_date, value: Date.today, class: "form-control shadow-sm" %>
            </div>
            <div class="col-md-6">
              <%= f.label :end_date, "End Date", class: "form-label uppercase-label" %>
              <%= f.date_field :end_date, value: Date.today + 1.month, class: "form-control shadow-sm" %>
            </div>
            <div class="col-12 mt-3">
              <%= f.submit "Generate Lessons", class: "btn btn-outline-primary w-100 py-2 shadow-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="py-5">
  <div class="table-responsive">
    <h2>Lektionsübersicht</h2>
    <table class="table table-bordered align-middle shadow-sm bg-white" style="border-radius: 8px; overflow: hidden;">
      <thead class="table-light">
        <tr>
          <th class="uppercase-label text-center" style="width: 80px;">KW</th>
          <% @subject.active_days.each do |day_idx| %>
            <th class="uppercase-label"><%= Date::DAYNAMES[day_idx] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @subject.lessons_by_week_and_day.each do |week, days| %>
          <tr>
            <td class="text-center fw-bold bg-light">
              <%= week %>
            </td>
            <% @subject.active_days.each do |day_idx| %>
              <td style="min-width: 250px; vertical-align: top;">
                <% Array(days[day_idx]).each do |lesson| %>
                  <div class="p-3 mb-3 border-start border-primary border-3 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <%# The Title: Clean, bold, and clearly a link without the 'button' bulk %>
                      <h6 class="mb-0 fw-bold">
                        <%= link_to lesson.title, lesson_path(lesson), 
                          class: "text-decoration-none subject-link" %>
                      </h6>

                      <span class="badge bg-light text-dark border fw-normal">
                        <i class="bi bi-clock me-1 text-muted"></i><%= lesson.start_time.strftime("%H:%M") %>
                      </span>
                    </div>

                    <div class="small text-muted mb-3 d-flex flex-wrap gap-2">
                      <span><i class="bi bi-calendar3 me-1"></i><%= lesson.start_time.strftime("%d.%m.") %></span>
                      <span class="text-secondary">|</span>
                      <span><i class="bi bi-people me-1"></i><%= @subject.group %></span>
                      <span class="text-secondary">|</span>
                      <span><i class="bi bi-door-open me-1"></i><%= @subject.room %></span>
                    </div>

                    <% # Phases Summary %>
                    <% titles = lesson.phases_summary %>
                    <% if titles.any? %>
                      <div class="mb-2 p-2 bg-white border shadow-sm">
                        <div class="fw-bold uppercase-label mb-1 text-primary" style="font-size: 0.65rem;">
                          <i class="bi bi-journal-text me-1"></i>Ablauf
                        </div>
                        <ol class="ps-3 mb-0 text-dark">
                          <% titles.each do |title| %>
                            <li><%= title %></li>
                          <% end %>
                        </ol>
                      </div>
                    <% end %>

                    <% # Material Summary %>
                    <% if lesson.materials_summary.any? %>
                      <div class="mt-2 p-2 bg-light border-start" style="font-size: 0.8rem;">
                        <div class="fw-bold uppercase-label mb-1 text-secondary" style="font-size: 0.65rem;">Planned Materials</div>
                        <ul class="list-unstyled mb-0 ps-1">
                          <% lesson.materials_summary.each do |mat| %>
                            <li><i class="bi bi-check2 text-primary me-1"></i><%= mat %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                      <%= link_to edit_lesson_path(lesson), class: "btn btn-sm btn-outline-primary border-0 ps-0 text-decoration-none" do %>
                        <i class="bi bi-pencil-square me-1"></i>Edit
                      <% end %>

                      <%= link_to lesson_path(lesson), 
                        class: "btn btn-sm btn-link text-danger p-0 text-decoration-none", 
                        data: { 
                          turbo_method: :delete, 
                          turbo_confirm: (lesson.phases.any? ? "This lesson has phases. Delete it?" : nil) 
                        } do %>
                        <i class="bi bi-trash3"></i>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
