<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Lehrerplaner" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lehrerplaner">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <% # Quill %>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <% # Questrial Font %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Questrial&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="background-color: #f8f9fa; font-family: 'Questrial', sans-serif;">
    <%# DARK NAVBAR with Green Brand Accent %>
    <nav class="navbar navbar-expand-lg" style="background-color: #1a1d21; border-bottom: 2px solid #09da69;">
      <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/" style="color: #09da69;">Hyperplaner</a>
        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
          <span class="navbar-toggler-icon"></span>
        </button>
<div class="collapse navbar-collapse" id="navbarSupportedContent">
  <ul class="navbar-nav me-auto mb-2 mb-lg-0">
    <li class="nav-item">
      <%= link_to "Subjects", subjects_path, class: "nav-link text-light opacity-75" %>
    </li>
    <li class="nav-item">
      <%= link_to "Lessons", lessons_path, class: "nav-link text-light opacity-75" %>
    </li>
  </ul>

  <%# --- USER MENU ON THE RIGHT --- %>
  <ul class="navbar-nav ms-auto align-items-center">
    <% if user_signed_in? %>
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          <%# The Sphere/Avatar %>
          <div class="user-avatar-circle">
            <%= current_user.email.first.upcase %>
          </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
          <li><h6 class="dropdown-header">Account</h6></li>
          <li><%= link_to "Settings", edit_user_registration_path, class: "dropdown-item" %></li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" %>
          </li>
        </ul>
      </li>
    <% else %>
      <li class="nav-item">
        <%= link_to "Login", new_user_session_path, class: "btn btn-sm btn-outline-light me-2" %>
      </li>
      <li class="nav-item">
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-sm btn-success text-dark fw-bold", style: "background-color: #09da69; border-color: #09da69;" %>
      </li>
    <% end %>
  </ul>
</div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if (controller_name == 'subjects' || controller_name == 'lessons') && action_name == 'show' %>
        <nav aria-label="breadcrumb" class="mb-4">
          <%# Dark Breadcrumb with Green Active Text %>
          <ol class="breadcrumb bg-dark p-3 shadow-sm rounded-0 border-start border-4" style="border-color: #09da69 !important;">
            <li class="breadcrumb-item">
              <%= link_to "Dashboard", subjects_path, class: "text-decoration-none text-light opacity-50 small" %>
            </li>

            <% if controller_name == 'subjects' %>
              <li class="breadcrumb-item active fw-bold" style="color: #09da69;">
                <%= @subject.name %>
              </li>
            <% end %>

            <% if controller_name == 'lessons' %>
              <li class="breadcrumb-item">
                <%= link_to @lesson.subject.name, subject_path(@lesson.subject), class: "text-decoration-none text-light opacity-50 small" %>
              </li>
              <li class="breadcrumb-item active fw-bold" style="color: #09da69;">
                <%= @lesson.title %>
              </li>
            <% end %>
          </ol>
        </nav>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
