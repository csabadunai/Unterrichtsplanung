<div class="header-actions mb-3">
  <div class="row g-2 mb-3"> <%# g-2 adds a small gap between buttons %>
  <% if params[:editing] %>
    <%# Hidden form for bulk update %>
    <%= form_with url: bulk_update_lesson_phases_path(@lesson), method: :patch, id: "bulk-edit-form" do %><% end %>

    <div class="btn-group">
      <div class="col-6">
        <button type="submit" form="bulk-edit-form" class="btn btn-primary w-100 rounded-0 shadow-sm">
          <i class="bi bi-check-lg me-1"></i> Save All
        </button>
      </div>

      <div class="col-6">
        <%= link_to lesson_path(@lesson), class: "btn btn-secondary w-100 rounded-0 shadow-sm" do %>
          <i class="bi bi-x-lg me-1"></i> Cancel
        <% end %>
      </div>
    </div>

  <% else %>
    <div class="col-12">
      <% if @lesson.subject.user == current_user || @lesson.subject.collaborations.exists?(user: current_user, role: 'editor') %>
        <%= link_to lesson_path(@lesson, editing: true), class: "btn btn-warning w-100 rounded-0 shadow-sm" do %>
          <i class="bi bi-pencil-square me-2"></i> Edit All Phases
        <% end %>
      <% else %>
        <div class="btn btn-light w-100 rounded-0 shadow-sm disabled text-muted">
          <i class="bi bi-lock-fill me-2"></i> Read Only
        </div>
      <% end %>
    </div>
  <% end %>
  </div>
</div>

<div class="row g-0 border-top border-bottom bg-light fw-bold align-items-stretch text-secondary" style="font-size: 0.85rem;">

  <div class="col-1 border-start border-end p-2 d-flex align-items-start">
    <span>Dauer &<br>Sozialform</span>
  </div>

  <div class="col-6 border-start border-end p-2 d-flex align-items-start">
    <span>Ablauf</span>
  </div>

  <div class="col-3 border-start border-end p-2 d-flex align-items-start">
    <span>Differenzierung</span>
  </div>

  <div class="col-2 border-start border-end p-2 d-flex align-items-start">
    <span>Material</span>
  </div>

</div>

<div id="phases">
  <% @phases.each do |phase| %>
    <%= turbo_frame_tag dom_id(phase) do %>
      <% if params[:editing] %>
        <%= render "phases/form", phase: phase, bulk: true %>
      <% else %>
        <%= render phase %>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="header-actions mb-3">
  <% if params[:editing] %>
    <%= link_to "New phase", new_lesson_phase_path(@lesson), class: "btn btn-outline-dark" %>
  <% end %>
</div>
