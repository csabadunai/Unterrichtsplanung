<%= form_with(model: phase) do |form| %>
  <% if phase.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(phase.errors.count, "error") %> prohibited this phase from being saved:</h2>

      <ul>
        <% phase.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :position %>
  <div class="row border-top border-bottom">
    <div class="col-1 border-start border-end">
      <%= form.number_field :duration, class: "form-control" %>
      <br>
      <%= form.text_field :social, class: "form-control" %>
    </div>

    <div class="col-6 border-start border-end">
      <%= form.textarea :description, class: "form-control h-100"  %>
    </div>

    <div class="col-3 border-start border-end">
      <%= form.textarea :differentiation, class: "form-control h-100"  %>
    </div>

    <div class="col-2 border-start border-end">
      <%= form.text_field :materials, class: "form-control h-100"  %>
    </div>

  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
