<%# app/views/phases/_form.html.erb %>
<% is_bulk = local_assigns[:bulk] %>
<% form_id = is_bulk ? "bulk-edit-form" : nil %>

<%# Capture the content so we can wrap it conditionally %>
<% form_content = capture do %>
  <%= fields_for "phases[]", phase do |f| %>
    <% if phase.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(phase.errors.count, "error") %> prohibited this phase from being saved:</h2>
        <ul><% phase.errors.each { |error| %><li><%= error.full_message %></li><% } %></ul>
      </div>
    <% end %>

    <%= f.hidden_field :position, form: form_id %>

    <% if phase.persisted? %>
    <% else %>
      <p class="badge bg-info text-dark">New Phase Insertion at Position <%= phase.position %></p>
    <% end %>

<div class="row border-top border-bottom py-2 align-items-stretch">
  <%# 1. Duration & Social (1 col) %>
  <div class="col-1 border-start border-end">
    <%= f.number_field :duration, class: "form-control mb-2", placeholder: "min", form: form_id %>
    <%= f.text_field :social, class: "form-control", placeholder: "Social", form: form_id %>

  <div class="btn-group-vertical shadow">
    <%= link_to new_lesson_phase_path(@lesson, position: phase.position, editing: true), class: "btn btn-sm btn-dark", title: "Insert", data: { turbo_frame: "_top" } do %>
      <i class="bi bi-plus-lg"></i>
    <% end %>

    <%= link_to lesson_phase_path(@lesson, phase, editing: true), class: "btn btn-sm btn-outline-danger", title: "Delete", data: { turbo_method: :delete, turbo_confirm: "Are you sure?", turbo_frame: "_top" } do %>
      <i class="bi bi-trash3"></i>
    <% end %>
  </div>

  <div class="btn-group-vertical shadow">
    <%= link_to move_higher_lesson_phase_path(@lesson, phase, editing: true), class: "btn btn-sm btn-dark", title: "Up", data: { turbo_method: :patch, turbo_frame: "_top" } do %>
      <i class="bi bi-chevron-up"></i>
    <% end %>

    <%= link_to move_lower_lesson_phase_path(@lesson, phase, editing: true), class: "btn btn-sm btn-dark", title: "Down", data: { turbo_method: :patch, turbo_frame: "_top" } do %>
      <i class="bi bi-chevron-down"></i>
    <% end %>
  </div>
  </div>

  <%# 2. Description (6 cols) %>
  <div class="col-6 border-start border-end">
    <% desc_id = "phase_desc_#{phase.id || "new_#{phase.object_id}"}" %>
    <%= f.hidden_field :description, id: "#{desc_id}_input", form: form_id %>
    <div id="<%= desc_id %>_editor" class="quill-editor-instance">
      <%= f.object.description.try(:html_safe) %>
    </div>
    <script>
      (function() {
        const quill = new Quill('#<%= desc_id %>_editor', { theme: 'snow' });
        const input = document.getElementById('<%= desc_id %>_input');
        quill.on('text-change', function() { input.value = quill.root.innerHTML; });
      })();
    </script>
  </div>

  <%# 3. Differentiation (2 cols - shrunk from 3 to make room) %>
  <div class="col-3 border-start border-end">
    <% diff_id = "phase_diff_#{phase.id || "new_#{phase.object_id}"}" %>
    <%= f.hidden_field :differentiation, id: "#{diff_id}_input", form: form_id %>
    <div id="<%= diff_id %>_editor" class="quill-editor-instance">
      <%= f.object.differentiation.try(:html_safe) %>
    </div>
    <script>
      (function() {
        const quill = new Quill('#<%= diff_id %>_editor', { theme: 'snow' });
        const input = document.getElementById('<%= diff_id %>_input');
        quill.on('text-change', function() { input.value = quill.root.innerHTML; });
      })();
    </script>
  </div>

  <%# 4. Materials (2 cols) %>
  <div class="col-2 border-start border-end">
    <%= f.text_area :materials, class: "form-control h-100", placeholder: "Materials...", form: form_id %>
  </div>
</div>

<% unless is_bulk %>
  <div class="mt-2">
    <%= f.submit "Update Phase", class: "btn btn-primary" %>
  </div>
<% end %>
  <% end %>
<% end %>

<%# The decision: wrap in a form tag or just spit out the fields %>
<% if is_bulk %>
  <%= form_content %>
<% else %>
  <%= form_with(model: [@lesson, phase]) { form_content } %>
<% end %>
