<p style="color: green"><%= notice %></p>

<% content_for :title, "Phases" %>

<h1>Phases</h1>

<div id="phases">
  <% @phases.each do |phase| %>
    <%= link_to "Insert Phase Above", new_phase_path(position: phase.position) %>
    <%= link_to "Move down", move_lower_phase_path(phase), data: { turbo_method: :patch } %>
    <%= link_to "Move up", move_higher_phase_path(phase), data: { turbo_method: :patch } %>
    <%= render phase %>
    <%= link_to "Show this phase", phase %>

  <% end %>
</div>

<%= link_to "New phase", new_phase_path %>
