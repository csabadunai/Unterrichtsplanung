<%# app/views/phases/index.html.erb %>
<p style="color: green"><%= notice %></p>

<div class="header-actions mb-3">
  <% if params[:editing] %>
    <%# The "Ghost Form" anchor %>
    <%= form_with url: bulk_update_lesson_phases_path(@lesson), method: :patch, id: "bulk-edit-form" do %><% end %>
    
    <button type="submit" form="bulk-edit-form" class="btn btn-success">Save All Phases</button>
    <%= link_to "Cancel Editing", lesson_phases_path(@lesson), class: "btn btn-secondary" %>
  <% else %>
    <%= link_to "Edit All Phases", lesson_phases_path(@lesson, editing: true), class: "btn btn-primary" %>
  <% end %>
</div>

<h1>Phases</h1>

<div id="phases">
  <% @phases.each do |phase| %>
    <%= turbo_frame_tag dom_id(phase) do %>
      <% if params[:editing] %>
        <%# THIS is where we pass 'phase' and 'bulk: true' to the partial %>
        <%= render "form", phase: phase, bulk: true %>
      <% else %>
        <%= render phase %>
      <% end %>
    <% end %>
    <hr>
  <% end %>
</div>

<%= link_to "New phase", new_lesson_phase_path(@lesson) %>
